  "entityTypes": [
    {
      "name": "player",
      "displayName": "Player",
      "sprite": "assets/entities/base/player.png",
      "properties": [
        {
          "name": "speed",
          "label": "Move Speed",
          "type": "number",
          "default": 200,
          "constraints": {
            "min": 50,
            "max": 500
          }
        },
        {
          "name": "health",
          "label": "Health",
          "type": "number",
          "default": 100,
          "constraints": {
            "min": 1,
            "max": 999
          }
        }
      ]
    },
    {
      "name": "enemy",
