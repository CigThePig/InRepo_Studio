        {
          "name": "speed",
          "label": "Move Speed",
          "type": "number",
          "default": 100,
          "constraints": {
            "min": 25,
            "max": 300
          }
        },
        {
          "name": "damage",
          "label": "Damage",
          "type": "number",
          "default": 10,
          "constraints": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "patrolDistance",
          "label": "Patrol Distance",
          "type": "number",
          "default": 100,
          "constraints": {
            "min": 0,
            "max": 500
          }
        }
      ]
    },
    {
      "name": "door",
      "displayName": "Door",
      "sprite": "assets/entities/base/door.png",
      "properties": [
        {
          "name": "targetScene",
          "label": "Target Scene",
          "type": "string",
          "default": ""
        },
        {
          "name": "spawnPoint",
          "label": "Spawn Point ID",
          "type": "string",
          "default": ""
        },
        {
          "name": "locked",
          "label": "Locked",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "name": "spawnPoint",
      "displayName": "Spawn Point",
      "properties": [
        {
          "name": "pointId",
          "label": "Point ID",
          "type": "string",
          "default": "spawn_1"
        }
      ]
    }
  ],
